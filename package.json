{
	"name": "avto-landing",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"server": "json-server --watch db.json --routes routes.json --port 3001",
		"double": "concurrently \"npm run dev\" \"npm run server\"",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint \"**/*.{js,ts,vue}\" && stylelint \"**/*.{css,scss,vue}\"",
		"lint:styles": "stylelint \"**/*.{css,scss,vue}\"",
		"lint:styles:fix": "stylelint \"**/*.{css,scss,vue}\" --fix",
		"lint:scripts": "eslint \"**/*.{js,ts,vue}\"",
		"lint:scripts:fix": "eslint \"**/*.{js,ts,vue}\" --fix",
		"format": "prettier --check \"**/*.{js,ts,vue,css,scss,json,md}\"",
		"format:fix": "prettier --write \"**/*.{js,ts,vue,css,scss,json,md}\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.9.0",
		"@hypernym/nuxt-gsap": "^2.4.3",
		"@pinia/nuxt": "^0.11.3",
		"@types/lodash.clonedeep": "^4.5.9",
		"@vueuse/core": "^14.1.0",
		"floating-vue": "^5.2.2",
		"glightbox": "^3.3.1",
		"lodash.clonedeep": "^4.5.0",
		"normalize.css": "^8.0.1",
		"nuxt": "^4.3.1",
		"nuxt-icons": "^4.0.0",
		"nuxt-schema-org": "^5.0.9",
		"pinia": "^3.0.4",
		"pinia-plugin-persistedstate": "^4.7.1",
		"split-type": "^0.3.4",
		"swiper": "^12.0.3",
		"typograf": "^7.6.0",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.28",
		"vue-final-modal": "^4.5.5",
		"vue-imask": "^7.6.1",
		"vue-router": "^4.6.4",
		"vue3-marquee": "^4.2.2",
		"yup": "^1.7.1"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.9.0",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/node": "^24.3.0",
		"concurrently": "^9.1.2",
		"eslint": "^9.34.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"husky": "^8.0.3",
		"json-server": "^0.17.4",
		"lint-staged": "^16.1.6",
		"postcss-html": "^1.8.0",
		"postcss-scss": "^4.0.9",
		"prettier": "^3.6.2",
		"sass": "^1.91.0",
		"sass-loader": "^16.0.5",
		"stylelint": "^16.23.1",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard": "^39.0.0",
		"stylelint-config-standard-scss": "^15.0.1",
		"stylelint-prettier": "^5.0.3",
		"vite-plugin-checker": "^0.12.0"
	},
	"lint-staged": {
		"*.{js,ts,vue}": "eslint --fix",
		"*.{css,scss,vue}": "stylelint --fix",
		"*.{js,ts,vue,css,scss,json,md}": "prettier --write"
	}
}
